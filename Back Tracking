#include <stdio.h>
#include <stdlib.h>

#define N 4   // Change N value (4, 5, 6...)

int board[N];

// Function to print solution
void printSolution() {
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            if (board[i] == j)
                printf(" 1 ");
            else
                printf(" 0 ");
        }
        printf("\n");
    }
    printf("\n");
}

// Check if placing queen is safe
int isSafe(int row, int col) {
    for (int i = 0; i < row; i++) {
        // Same column or diagonal check
        if (board[i] == col || 
            abs(board[i] - col) == abs(i - row))
            return 0;
    }
    return 1;
}

// Backtracking function
void solveNQueens(int row) {
    if (row == N) {
        printSolution();
        return;
    }

    for (int col = 0; col < N; col++) {
        if (isSafe(row, col)) {
            board[row] = col;   // Place queen
            solveNQueens(row + 1); // Recur
        }
    }
}

int main() {
    printf("Solutions for %d-Queens Problem:\n\n", N);
    solveNQueens(0);
    return 0;
}