import random

print("=" * 50)
print("      WELCOME TO THE NUMBER GUESSING GAME")
print("=" * 50)

score = 0
round_number = 1

while True:
    print(f"\n========== ROUND {round_number} ==========")

    # Generate random number
    secret_number = random.randint(1, 100)

    max_attempts = 10
    attempts = 0
    guessed = False

    print("I have selected a number between 1 and 100.")
    print(f"You have {max_attempts} attempts to guess it.")

    while attempts < max_attempts:
        try:
            guess = int(input("\nEnter your guess: "))
        except ValueError:
            print("Please enter a valid integer.")
            continue

        attempts += 1

        if guess < secret_number:
            print("Too Low!")
        elif guess > secret_number:
            print("Too High!")
        else:
            print("\nCongratulations!")
            print(f"You guessed the correct number {secret_number} in {attempts} attempts.")

            # Score Calculation
            round_score = max_attempts - attempts + 1
            score += round_score

            print(f"You earned {round_score} points.")
            guessed = True
            break

        print(f"Attempts Left: {max_attempts - attempts}")

    if not guessed:
        print("\nGame Over!")
        print(f"The correct number was {secret_number}.")

    print("\nCurrent Score:", score)

    # Play Again Option
    play_again = input("\nDo you want to play another round? (yes/no): ").lower()

    if play_again != "yes":
        break

    round_number += 1

print("\n" + "=" * 50)
print("GAME SUMMARY")
print("=" * 50)
print("Rounds Played:", round_number)
print("Final Score:", score)
print("Thank you for playing!")